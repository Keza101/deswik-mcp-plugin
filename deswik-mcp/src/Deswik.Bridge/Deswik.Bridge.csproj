<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>Deswik.Bridge</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!-- Deswik API References - resolve from DESWIK_DIR or -p:DeswikDir -->
  <PropertyGroup>
    <DeswikDir Condition="'$(DeswikDir)' == ''">$(DESWIK_DIR)</DeswikDir>
  </PropertyGroup>

  <Target Name="RequireDeswikDir" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DeswikDir)' == ''" Text="Set DESWIK_DIR or pass -p:DeswikDir to your Deswik.Suite installation folder." />
  </Target>

  <ItemGroup>
    <!-- Scheduler API -->
    <Reference Include="Deswik.Scheduler.API">
      <HintPath>$(DeswikDir)\Deswik.Scheduler.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.Scheduler.API.Contracts">
      <HintPath>$(DeswikDir)\Deswik.Scheduler.API.Contracts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.Scheduler.Contracts">
      <HintPath>$(DeswikDir)\Deswik.Scheduler.Contracts.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.Scheduler.Engine">
      <HintPath>$(DeswikDir)\Deswik.Scheduler.Engine.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- LHS/CAD API -->
    <Reference Include="Deswik.LHS">
      <HintPath>$(DeswikDir)\Deswik.LHS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.LHS.API">
      <HintPath>$(DeswikDir)\Deswik.LHS.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.LHS.CAD.API">
      <HintPath>$(DeswikDir)\Deswik.LHS.CAD.API.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.LHS.DAL">
      <HintPath>$(DeswikDir)\Deswik.LHS.DAL.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
