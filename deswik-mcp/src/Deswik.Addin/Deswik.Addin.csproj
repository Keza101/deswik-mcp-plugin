<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <OutputType>Library</OutputType>
    <AssemblyName>Deswik.Addin</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <!-- Match the installed Deswik.Graphics build so the plugin host accepts it. -->
    <AssemblyVersion>2025.2.3940.40169</AssemblyVersion>
    <FileVersion>2025.2.3940.40169</FileVersion>
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <PropertyGroup>
    <DeswikDir Condition="'$(DeswikDir)' == ''">$(DESWIK_DIR)</DeswikDir>
  </PropertyGroup>

  <Target Name="RequireDeswikDir" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DeswikDir)' == ''" Text="Set DESWIK_DIR or pass -p:DeswikDir to your Deswik.Suite installation folder." />
  </Target>

  <ItemGroup>
    <Reference Include="Deswik.Graphics">
      <HintPath>$(DeswikDir)\Deswik.Graphics.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.Common.Utilities">
      <HintPath>$(DeswikDir)\Deswik.Common.Utilities.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.Common.Core">
      <HintPath>$(DeswikDir)\Deswik.Common.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.Geometry">
      <HintPath>$(DeswikDir)\Deswik.Geometry.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Deswik.OPDB.Common">
      <HintPath>$(DeswikDir)\Deswik.OPDB.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="VectorDraw.Core.6">
      <HintPath>$(DeswikDir)\VectorDraw.Core.6.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Deswik.Bridge\Deswik.Bridge.csproj" />
  </ItemGroup>

</Project>
