and draw a Deswik Logo</_text><Alpha>255</Alpha><TableTextCount>0</TableTextCount><TFormat><FontName>Microsoft Sans Serif</FontName><Size>21</Size><Style>Bold</Style><FormatFlags>0</FormatFlags><Alignment>Near</Alignment><LineAlignment>Center</LineAlignment></TFormat><TitleFormat><FontName>Tahoma</FontName><Size>11.5</Size><Style>Regular</Style><FormatFlags>0</FormatFlags><Alignment>Center</Alignment><LineAlignment>Center</LineAlignment></TitleFormat><_rotation>0</_rotation><_scale><X>420</X><Y>100</Y></_scale><_translation><X>60</X><Y>60</Y></_translation></node></nodes><links /><Tag1>MaintainStatusInDocument=False|DefaultLayers=Main|MaintainLayerVisibilityInDocument=False</Tag1><CanvasScale>0.8</CanvasScale><CanvasPos><X>0</X><Y>0</Y></CanvasPos><VisibleLayerMask>1</VisibleLayerMask><VisibleLayerMaskNew>False:1</VisibleLayerMaskNew><ActiveLayer>Main</ActiveLayer><OneLayerSelectMode>True</OneLayerSelectMode><Layers64><Layer><Name>Main</Name><MaskIdx>0</MaskIdx></Layer></Layers64></doc>Ò<?xml version="1.0" encoding="utf-16"?><DiagramAppearance xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema"><BackgroundColor>-13748925</BackgroundColor><BackgroundColor2>-1</BackgroundColor2><Size><Width>560</Width><Height>1200</Height></Size><TextFormat><FontName>Tahoma</FontName><Size>11.5</Size><Style>Regular</Style><FormatFlags /><Alignment>Center</Alignment><LineAlignment>Center</LineAlignment></TextFormat><ShowGrid>true</ShowGrid><GridSize>10</GridSize><CanvasOrigin><X>2</X><Y>2</Y></CanvasOrigin><Snap>true</Snap></DiagramAppearance>