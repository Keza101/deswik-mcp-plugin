&lt;NewDataSet&gt;&lt;Deswik_OPIS_Settings&gt;&lt;_EditNodeCreateLayers_SplitPosition1&gt;252&lt;/_EditNodeCreateLayers_SplitPosition1&gt;&lt;_EditNodeCreateLayers_SplitPosition2&gt;392&lt;/_EditNodeCreateLayers_SplitPosition2&gt;&lt;_EditNodeCreateLayers_OverwriteIconsInDocument&gt;True&lt;/_EditNodeCreateLayers_OverwriteIconsInDocument&gt;&lt;_EditNodeCreateLayers_Icons_Count&gt;0&lt;/_EditNodeCreateLayers_Icons_Count&gt;&lt;_EditNodeCreateLayers_Count&gt;3&lt;/_EditNodeCreateLayers_Count&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__Name&gt;DESIGN - FIRING1&lt;/_EditNodeCreateLayers_x005B_0_x005D__Name&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__HonorAttributeRules&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__HonorAttributeRules&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__AttributesListAttributeCount&gt;0&lt;/_EditNodeCreateLayers_x005B_0_x005D__AttributesListAttributeCount&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_LayerName /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_LayerPath /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_ParentLayerName /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsVisible&gt;True&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsVisible&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsLocked&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsLocked&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsLoaded&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsLoaded&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsImportLoaded&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsImportLoaded&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsDynamic&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsDynamic&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsRelativeDynamic&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsRelativeDynamic&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsRelativeDataSource&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsRelativeDataSource&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsChildLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsChildLayer&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsChildDataLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsChildDataLayer&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsLoadedEnabled&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsLoadedEnabled&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsImported&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsImported&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsReferenceOnly&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_IsReferenceOnly&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_LineWeight&gt;-3&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_LineWeight&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_Description /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DynamicFile /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceFile /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceFileType /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceDataType /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceLayer /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceFilterString /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceLoadAllLayers&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_DatasourceLoadAllLayers&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_ApplyChangesToChildLayers&gt;True&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_ApplyChangesToChildLayers&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_Icon /&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_IsByBlock&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_IsByBlock&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_IsByLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_IsByLayer&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_IsByColorIndex&gt;True&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_IsByColorIndex&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_ColorIndex&gt;6&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_ColorIndex&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_SystemColor&gt;-1&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_SystemColor&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_Transparency&gt;255&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_Transparency&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_KeepColorInLayouts&gt;False&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_PenColor_KeepColorInLayouts&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_LineType&gt;SOLID&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_LineType&gt;&lt;_EditNodeCreateLayers_x005B_0_x005D__LayerProps_NodeBackColor&gt;16777215&lt;/_EditNodeCreateLayers_x005B_0_x005D__LayerProps_NodeBackColor&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__Name&gt;DESIGN - RINGS&lt;/_EditNodeCreateLayers_x005B_1_x005D__Name&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__HonorAttributeRules&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__HonorAttributeRules&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__AttributesListAttributeCount&gt;0&lt;/_EditNodeCreateLayers_x005B_1_x005D__AttributesListAttributeCount&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_LayerName /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_LayerPath /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_ParentLayerName /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsVisible&gt;True&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsVisible&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsLocked&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsLocked&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsLoaded&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsLoaded&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsImportLoaded&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsImportLoaded&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsDynamic&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsDynamic&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsRelativeDynamic&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsRelativeDynamic&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsRelativeDataSource&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsRelativeDataSource&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsChildLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsChildLayer&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsChildDataLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsChildDataLayer&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsLoadedEnabled&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsLoadedEnabled&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsImported&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsImported&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsReferenceOnly&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_IsReferenceOnly&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_LineWeight&gt;-3&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_LineWeight&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_Description /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DynamicFile /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceFile /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceFileType /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceDataType /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceLayer /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceFilterString /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceLoadAllLayers&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_DatasourceLoadAllLayers&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_ApplyChangesToChildLayers&gt;True&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_ApplyChangesToChildLayers&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_Icon /&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_IsByBlock&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_IsByBlock&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_IsByLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_IsByLayer&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_IsByColorIndex&gt;True&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_IsByColorIndex&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_ColorIndex&gt;6&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_ColorIndex&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_SystemColor&gt;-1&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_SystemColor&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_Transparency&gt;255&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_Transparency&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_KeepColorInLayouts&gt;False&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_PenColor_KeepColorInLayouts&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_LineType&gt;SOLID&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_LineType&gt;&lt;_EditNodeCreateLayers_x005B_1_x005D__LayerProps_NodeBackColor&gt;16777215&lt;/_EditNodeCreateLayers_x005B_1_x005D__LayerProps_NodeBackColor&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__Name&gt;DESIGN - CABLES&lt;/_EditNodeCreateLayers_x005B_2_x005D__Name&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__HonorAttributeRules&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__HonorAttributeRules&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__AttributesListAttributeCount&gt;0&lt;/_EditNodeCreateLayers_x005B_2_x005D__AttributesListAttributeCount&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_LayerName /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_LayerPath /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_ParentLayerName /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsVisible&gt;True&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsVisible&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsLocked&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsLocked&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsLoaded&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsLoaded&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsImportLoaded&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsImportLoaded&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsDynamic&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsDynamic&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsRelativeDynamic&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsRelativeDynamic&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsRelativeDataSource&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsRelativeDataSource&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsChildLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsChildLayer&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsChildDataLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsChildDataLayer&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsLoadedEnabled&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsLoadedEnabled&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsImported&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsImported&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsReferenceOnly&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_IsReferenceOnly&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_LineWeight&gt;-3&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_LineWeight&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_Description /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DynamicFile /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceFile /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceFileType /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceDataType /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceLayer /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceFilterString /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceLoadAllLayers&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_DatasourceLoadAllLayers&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_ApplyChangesToChildLayers&gt;True&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_ApplyChangesToChildLayers&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_Icon /&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_IsByBlock&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_IsByBlock&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_IsByLayer&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_IsByLayer&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_IsByColorIndex&gt;True&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_IsByColorIndex&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_ColorIndex&gt;6&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_ColorIndex&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_SystemColor&gt;-1&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_SystemColor&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_Transparency&gt;255&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_Transparency&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_KeepColorInLayouts&gt;False&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_PenColor_KeepColorInLayouts&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_LineType&gt;SOLID&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_LineType&gt;&lt;_EditNodeCreateLayers_x005B_2_x005D__LayerProps_NodeBackColor&gt;16777215&lt;/_EditNodeCreateLayers_x005B_2_x005D__LayerProps_NodeBackColor&gt;&lt;_dw_LayerCustomColors_Count&gt;0&lt;/_dw_LayerCustomColors_Count&gt;&lt;/Deswik_OPIS_Settings&gt;&lt;/NewDataSet&gt;**||**Use=True**||**Description=**||**EmbeddedMacro:'#Language "WWB.NET"

Imports Deswik.Graphics

' Draw one ring/cable as a line from the floor (offB,zbot) to the back
' (offT,ztop), where offB/offT are distances along the long axis from the
' start end. A dump tilts the top forward, so offT = offB + tan(dump)*height.
Sub DrawSeg(ByVal offB As Double, ByVal offT As Double, ByVal zbot As Double, ByVal ztop As Double, _
            ByVal startU As Double, ByVal dirS As Double, ByVal mx As Double, ByVal my As Double, _
            ByVal ux As Double, ByVal uy As Double, _
            ByVal lay As Deswik.Graphics.Primaries.Layer, ByVal r As Integer, ByVal g As Integer, ByVal b As Integer)
    Dim uwB As Double = startU + dirS * offB
    Dim uwT As Double = startU + dirS * offT
    Dim pts As New System.Collections.Generic.List(Of Deswik.Graphics.Geometry.Point)
    pts.Add(New Deswik.Graphics.Geometry.Point(mx + uwB * ux, my + uwB * uy, zbot))
    pts.Add(New Deswik.Graphics.Geometry.Point(mx + uwT * ux, my + uwT * uy, ztop))
    Dim pl As New Deswik.Graphics.Figures.Polyline(pts)
    pl.Layer = lay
    pl.PenColor.SetRGB(r, g, b)
    CurrentDoc.ActiveLayOut.Entities.AddItem(pl)
End Sub

Sub Main

    Dim layF1 = CurrentDoc.Layers.FindName("DESIGN - FIRING1")
    Dim layRings = CurrentDoc.Layers.FindName("DESIGN - RINGS")
    Dim layCables = CurrentDoc.Layers.FindName("DESIGN - CABLES")

    ' clear any previously-generated design strings so re-runs don't pile up
    layF1.DeleteAllEntities(False, False, Nothing, True)
    layRings.DeleteAllEntities(False, False, Nothing, True)
    layCables.DeleteAllEntities(False, False, Nothing, True)

    ' --- selected solid (ShowGrips), largest ---
    Dim best As Deswik.Graphics.Figures.Polyface = Nothing
    Dim bestVol As Double = -1
    Dim lj As Integer
    For lj = 0 To CurrentDoc.Layers.Count - 1
        Dim L = CurrentDoc.Layers.Item(lj)
        Dim le = L.Entities
        Dim k As Integer
        For k = 0 To le.Count - 1
            Dim fig As Deswik.Graphics.Primaries.Figure = le.Item(k)
            If fig.IsPolyface AndAlso fig.ShowGrips Then
                Dim pf = fig.asPolyface
                Dim bb = pf.BoundingBox
                Dim vol As Double = bb.DX * bb.DY * bb.DZ
                If vol &gt; bestVol Then
                    bestVol = vol
                    best = pf
                End If
            End If
        Next
    Next
    If best Is Nothing Then
        MsgBox("Select a stope solid first (grips showing), then click this node.")
        Exit Sub
    End If

    ' --- ask the user for burden spacing ---
    Dim burdenStr As String = InputBox("Enter burden spacing (m):", "Burden Spacing", "2.0")
    Dim burden As Double
    If Not Double.TryParse(burdenStr, burden) Then
        MsgBox("Invalid number. Using default 2.0 m.")
        burden = 2.0
    End If
    If burden &lt;= 0 Then
        MsgBox("Burden must be positive. Using 2.0 m.")
        burden = 2.0
    End If

    ' --- PCA long axis from a horizontal slice at the centroid ---
    Dim cog = best.CenterOfGravity
    Dim zloops = best.GenerateSlicePoints(cog, New Deswik.Graphics.Geometry.Vector(0, 0, 1))
    Dim sx As Double = 0, sy As Double = 0, sxx As Double = 0, syy As Double = 0, sxy As Double = 0
    Dim n As Integer = 0
    For Each vl As Deswik.Graphics.Geometry.Verticies In zloops
        Dim i As Integer
        For i = 0 To vl.Count - 1
            Dim p = vl.Item(i)
            sx = sx + p.x : sy = sy + p.y
            sxx = sxx + p.x * p.x : syy = syy + p.y * p.y : sxy = sxy + p.x * p.y
            n = n + 1
        Next
    Next
    If n = 0 Then
        MsgBox("Reference slice empty.")
        Exit Sub
    End If
    Dim mx As Double = sx / n, my As Double = sy / n
    Dim cxx As Double = sxx / n - mx * mx
    Dim cyy As Double = syy / n - my * my
    Dim cxy As Double = sxy / n - mx * my
    Dim theta As Double = 0.5 * System.Math.Atan2(2.0 * cxy, cxx - cyy)
    Dim ux As Double = System.Math.Cos(theta)
    Dim uy As Double = System.Math.Sin(theta)

    ' --- longitudinal section, build U (length) / Z (height) frame ---
    Dim secNormal As New Deswik.Graphics.Geometry.Vector(-uy, ux, 0)
    Dim mid As New Deswik.Graphics.Geometry.Point(mx, my, cog.z)
    Dim secLoops = best.GenerateSlicePoints(mid, secNormal)
    Dim uMin As Double = 1.0E+30, uMax As Double = -1.0E+30
    Dim zMin As Double = 1.0E+30, zMax As Double = -1.0E+30
    For Each vl3 As Deswik.Graphics.Geometry.Verticies In secLoops
        Dim j As Integer
        For j = 0 To vl3.Count - 1
            Dim p2 = vl3.Item(j)
            Dim u As Double = (p2.x - mx) * ux + (p2.y - my) * uy
            If u &lt; uMin Then uMin = u
            If u &gt; uMax Then uMax = u
            If p2.z &lt; zMin Then zMin = p2.z
            If p2.z &gt; zMax Then zMax = p2.z
        Next
    Next
    Dim Ltot As Double = uMax - uMin
    If Ltot &lt;= 0 Then
        MsgBox("Section length is zero.")
        Exit Sub
    End If

    Dim cableTop As Double = zMin + 6.5
    If cableTop &gt; zMax Then cableTop = zMax

    ' --- ask the user for layout direction along the long axis ---
    Dim startU As Double = uMin
    Dim dirS As Double = 1.0
    If MsgBox("Lay out LEFT-to-RIGHT?" &amp; vbCrLf &amp; "(Yes = left-to-right, No = right-to-left)", vbYesNo, "Layout direction") = vbNo Then
        startU = uMax
        dirS = -1.0
    End If

    ' --- dump geometry: top of each ring leans forward by tan(dump)*height ---
    Dim dz As Double = zMax - zMin
    Dim d2r As Double = System.Math.PI / 180.0
    Dim tan10 As Double = System.Math.Tan(10.0 * d2r) * dz   ' all formal/FIRING1 rings
    Dim tanSU1 As Double = System.Math.Tan(20.0 * d2r) * dz  ' 1st standing-up ring (20 deg)
    Dim tanSU2 As Double = System.Math.Tan(15.0 * d2r) * dz  ' 2nd standing-up ring (15 deg)

    ' --- lay out along the length (off = distance from the start end) ---
    Dim off As Double

    ' FIRING1 longhole rise: rings @ 2m over first 3 m (red), VERTICAL (no dump)
    off = 0
    Dim lastF1 As Double = 0
    While off &lt;= 3.0 AndAlso off &lt;= Ltot
        DrawSeg(off, off, zMin, zMax, startU, dirS, mx, my, ux, uy, layF1, 255, 60, 60)
        lastF1 = off
        off = off + burden
    End While

    ' first stope cable: 1.5 m from the last FIRING1 ring (cyan, 6.5 m, vertical)
    Dim cab1 As Double = lastF1 + 1.5
    If cab1 &lt;= Ltot Then
        DrawSeg(cab1, cab1, zMin, cableTop, startU, dirS, mx, my, ux, uy, layCables, 0, 200, 255)
    End If

    ' two standing-up rings (orange): both COLLARS (bottom, on the floor drive)
    ' 0.5 m past the cable, fanning UP at 20 deg and 15 deg. Toe (top) =
    ' collar - tan(dump)*height (leans back, same direction as the formal rings).
    Dim collarOff As Double = cab1 + 0.5

    ' SU1: collar (bottom) FIXED 0.5 m past cable1; dumps back at 20 deg toward
    ' F1. If the full-height hole would reach within 0.5 m of the F1 ring, the
    ' hole is shortened (angle preserved) so its toe stops 0.5 m from F1.
    Dim su1FullToe As Double = collarOff - tanSU1
    Dim su1MinToe As Double = lastF1 + 0.5
    Dim su1ToeOff As Double = su1FullToe
    Dim su1ToeZ As Double = zMax
    If su1FullToe &lt; su1MinToe Then
        su1ToeOff = su1MinToe
        su1ToeZ = zMin + (collarOff - su1MinToe) / tanSU1 * dz
    End If
    DrawSeg(collarOff, su1ToeOff, zMin, su1ToeZ, startU, dirS, mx, my, ux, uy, layRings, 255, 140, 0)

    ' SU2 (same philosophy as SU1: fixed collar, truncated toe). Collar (bottom)
    ' = midpoint of SU1 collar and the first main ring collar. The hole DIRECTION
    ' is aimed so it would sit 2 m from the main ring toe; the hole is then
    ' truncated where it reaches 0.5 m from F1 â€” that point is SU2's toe.
    ' The dump angle is the variable result of this construction.
    Dim main1Toe As Double = lastF1 + 1.0
    Dim main1Collar As Double = main1Toe + tan10
    Dim su2Collar As Double = (collarOff + main1Collar) / 2.0
    Dim su2Aim As Double = main1Toe - 2.0          ' 2 m from main ring toe (toward F1)
    Dim su2ToeOff As Double = lastF1 + 0.5         ' 0.5 m from F1 (truncation line)
    Dim su2t As Double = (su2ToeOff - su2Collar) / (su2Aim - su2Collar)
    Dim su2ToeZ As Double = zMin + su2t * dz
    DrawSeg(su2Collar, su2ToeOff, zMin, su2ToeZ, startU, dirS, mx, my, ux, uy, layRings, 255, 140, 0)

    ' F2 rings: SU1 + SU2 + up to 3 main rings = max 5 rings total (orange/yellow).
    ' Draw them, count them, then STOP and put a closing cable â€” no FIRING3+.
    ' Formal main rings @ 2 m toe spacing, 10 deg dump. First collar anchored 1 m
    ' from last F1 ring toe (moved back toward F1).
    Dim f2Count As Integer = 2                    ' SU1 + SU2 = 2 rings already placed
    off = (lastF1 + 1.0) + tan10
    Dim lastRing As Double = off
    While off &lt;= (Ltot - 1.5) AndAlso f2Count &lt; 5
        DrawSeg(off, off - tan10, zMin, zMax, startU, dirS, mx, my, ux, uy, layRings, 255, 140, 0)
        lastRing = off
        f2Count = f2Count + 1
        off = off + burden
    End While

    ' closing stope cable: 1.5 m from the last ring (cyan, 6.5 m, vertical)
    If f2Count &gt; 0 Then
        Dim endCable As Double = lastRing + 1.5
        If endCable &lt;= Ltot Then
            DrawSeg(endCable, endCable, zMin, cableTop, startU, dirS, mx, my, ux, uy, layCables, 0, 200, 255)
        End If
    End If

    CurrentDoc.Regen(True)

    MsgBox("Design layout drawn." &amp; vbCrLf &amp; "Section length = " &amp; System.Math.Round(Ltot, 1).ToString() &amp; " m" &amp; vbCrLf &amp; "F2 rings placed = " &amp; f2Count.ToString())

End Sub
